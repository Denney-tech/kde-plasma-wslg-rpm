+namespace {
+wl_buffer *createFallbackBlackBuffer(wl_shm *shm, int width, int height)
+{
+    if (!shm) {
+        return nullptr;
+    }
+    width = std::max(width, 1);
+    height = std::max(height, 1);
+    const int stride = width * 4;
+    const int size = stride * height;
+
+    int fd = memfd_create("kwin-shm-fallback", MFD_CLOEXEC);
+    if (fd < 0) {
+        return nullptr;
+    }
+    if (ftruncate(fd, size) < 0) {
+        close(fd);
+        return nullptr;
+    }
+    void *data = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (data == MAP_FAILED) {
+        close(fd);
+        return nullptr;
+    }
+    std::memset(data, 0, size); // opaque black (XRGB8888 ignores the alpha byte)
+    munmap(data, size);
+
+    wl_shm_pool *pool = wl_shm_create_pool(shm, fd, size);
+    close(fd); // safe: libwayland dups the fd during request marshalling
+    wl_buffer *buffer = wl_shm_pool_create_buffer(pool, 0, width, height, stride, WL_SHM_FORMAT_XRGB8888);
+    wl_shm_pool_destroy(pool);
+    return buffer;
+}
+}
